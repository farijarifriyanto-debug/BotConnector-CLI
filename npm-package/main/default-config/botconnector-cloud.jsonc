{
  "provider": {
    "botconnector": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "BotConnector Gateway",
      "env": ["BOTCONNECTOR_API_KEY"],
      "options": {
        "baseURL": "https://api.botconnector.id/v1"
      },
      "models": {}
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {}
    }
  }
}
